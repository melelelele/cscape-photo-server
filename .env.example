# Netzwerk
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://10.127.0.17:8000

# Nur für einen späteren öffentlichen Betrieb mit Caddy relevant.
DOMAIN=localhost

# PostgreSQL
POSTGRES_DB=cscape_photo
POSTGRES_USER=cscape_photo
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Gemeinsames Geheimnis zwischen CSCape und diesem Server.
CSCAPE_API_KEY=CHANGE_ME_CSCAPE_API_KEY

# xAI / Grok
XAI_API_KEY=CHANGE_ME_XAI_API_KEY
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=120
XAI_IMAGE_DETAIL=high

# Anwendung
ENVIRONMENT=production
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_DIMENSION=1600
JPEG_QUALITY=85
DEFAULT_TASK_TTL_SECONDS=86400


